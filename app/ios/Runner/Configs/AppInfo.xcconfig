// Application-level settings for the Runner target, included by
// `Flutter/Debug.xcconfig` and `Flutter/Release.xcconfig`.

// DexBot's name and bundle id, written once for every platform.
#include "../../../identity.xcconfig"

// The name under the icon (Info.plist).
FROCKBOT_DISPLAY_NAME = $(DEXBOT_APP_NAME)

// The application's bundle identifier. The release shares the Mac app's.
PRODUCT_BUNDLE_IDENTIFIER = $(DEXBOT_APPLE_BUNDLE_ID)

// The custom scheme the browser's sign-in and Connect returns hand over on
// (Info.plist): DexBot's own, from `identity.xcconfig`, which the brand names
// too (`nativeScheme`).
FROCKBOT_URL_SCHEME = $(DEXBOT_URL_SCHEME)

// The asset catalog app icon (selected in the Runner target's build settings).
FROCKBOT_APP_ICON = AppIcon

// Push and the associated sign-in domain. Signing needs DexBot's own Apple
// team, set here or in Xcode once it exists.
CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements
