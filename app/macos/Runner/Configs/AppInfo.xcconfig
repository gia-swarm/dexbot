// Application-level settings for the Runner target.

// DexBot's name and bundle id, written once for every platform.
#include "../../../identity.xcconfig"

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = $(DEXBOT_APP_NAME)

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = $(DEXBOT_APPLE_BUNDLE_ID)

// The custom scheme the browser's sign-in and Connect returns hand over on
// (Info.plist): DexBot's own, from `identity.xcconfig`, which the brand names
// too (`nativeScheme`).
FROCKBOT_URL_SCHEME = $(DEXBOT_URL_SCHEME)

// The asset catalog app icon (selected in the Runner target's build settings).
FROCKBOT_APP_ICON = AppIcon

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 DexBot. All rights reserved.

// Signing needs DexBot's own Apple team, set here or in Xcode once it exists.
CODE_SIGN_IDENTITY = Apple Development
